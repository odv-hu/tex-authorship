{
  "name": "tex-authorship",
  "displayName": "TeX Authorship",
  "description": "Authorship tracking for LaTeX: mark pasted text as AI, reference or co-author with comment markers, see it tinted in the editor and coloured in a LuaLaTeX draft PDF. Inspired by iA Writer's Authorship.",
  "version": "0.1.20",
  "publisher": "odv-hu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/odv-hu/tex-authorship.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "latex",
    "authorship",
    "ai",
    "ia writer",
    "provenance"
  ],
  "icon": "images/icon.png",
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex"
  ],
  "contributes": {
    "commands": [
      {
        "command": "texAuthorship.pasteAs",
        "title": "Paste as\u2026",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.markSelection",
        "title": "Mark Selection as\u2026",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.unmark",
        "title": "Unmark Passage (make it mine)",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.showStats",
        "title": "Show Authorship Statistics",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.toggleHighlight",
        "title": "Toggle Highlighting",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.copyLatexPackage",
        "title": "Copy LaTeX Package into This Project (for sharing or submission)",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.installLatexPackage",
        "title": "Install LaTeX Package for All Documents",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.buildDraft",
        "title": "Build Coloured Draft (LuaLaTeX)",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.associateReference",
        "title": "Associate Reference Source\u2026",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.reviewed",
        "title": "Mark AI Passage as Reviewed\u2026",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.revised",
        "title": "Mark AI Passage as Revised\u2026",
        "category": "Authorship"
      },
      {
        "command": "texAuthorship.clearReview",
        "title": "Remove AI Passage Review",
        "category": "Authorship"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "editor.action.clipboardCutAction",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-100"
        },
        {
          "command": "editor.action.clipboardCopyAction",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-99"
        },
        {
          "command": "editor.action.clipboardPasteAction",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-98"
        },
        {
          "command": "texAuthorship.pasteAs",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-90"
        },
        {
          "command": "texAuthorship.markSelection",
          "when": "editorHasSelection && (resourceLangId == latex || resourceLangId == tex)",
          "group": "navigation@-89"
        },
        {
          "command": "texAuthorship.unmark",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-88"
        },
        {
          "command": "texAuthorship.associateReference",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-87"
        },
        {
          "command": "texAuthorship.reviewed",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-86"
        },
        {
          "command": "texAuthorship.revised",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-85"
        },
        {
          "command": "texAuthorship.clearReview",
          "when": "resourceLangId == latex || resourceLangId == tex",
          "group": "navigation@-84"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texAuthorship.pasteAs",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && (resourceLangId == latex || resourceLangId == tex)"
      }
    ],
    "configuration": {
      "title": "TeX Authorship",
      "properties": {
        "texAuthorship.authors": {
          "type": "array",
          "description": "Authors offered when pasting or marking. kind: ai (& prefix), human (@ prefix) or reference (* prefix). Text outside markers is always yours.",
          "default": [
            {
              "label": "AI: Claude",
              "kind": "ai",
              "color": "#e0218a"
            },
            {
              "label": "Reference",
              "kind": "reference",
              "color": "#8a8a8a"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "label",
              "kind"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "Name shown in menus and written into the marker, e.g. \"AI: Claude\" -> %[&AI: Claude]"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ai",
                  "human",
                  "reference"
                ]
              },
              "color": {
                "type": "string",
                "description": "Hex colour, e.g. #e0218a"
              }
            }
          }
        },
        "texAuthorship.ownerName": {
          "type": "string",
          "default": "Mine",
          "description": "Name for your own (unmarked) text in the status bar and paste menu. An \\AuthorshipOwner{...} line in your .tex files takes precedence."
        },
        "texAuthorship.installLatexPackage": {
          "type": "boolean",
          "default": true,
          "description": "Keep the LaTeX package (authorship.sty + authorship.lua) installed and up to date in your personal TeX folder (TEXMFHOME), so \\usepackage{authorship} works in every document without copies."
        },
        "texAuthorship.highlight": {
          "type": "boolean",
          "default": true,
          "description": "Tint marked passages in the editor."
        },
        "texAuthorship.backgroundOpacity": {
          "type": "number",
          "default": 0.14,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of the line tint behind marked passages."
        },
        "texAuthorship.markerOpacity": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of the marker comment lines themselves."
        },
        "texAuthorship.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "latex",
            "tex"
          ],
          "description": "Language IDs the extension works in (reload the window after changing)."
        },
        "texAuthorship.draftRecipe": {
          "type": "string",
          "default": "latexmk (lualatex)",
          "description": "LaTeX Workshop recipe used by \"Build Coloured Draft\"."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "tsc -p jsconfig.json",
    "package": "npx --yes @vscode/vsce@3 package --allow-missing-repository",
    "check:release": "node scripts/check-release.js",
    "test:integration": "node test/integration/run.js",
    "test:pdf": "python3 test/pdf-regression.py"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "2.5.2",
    "typescript": "^5.6.0"
  }
}
