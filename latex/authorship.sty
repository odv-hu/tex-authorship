%% authorship.sty -- colour text by author in a LuaLaTeX draft, from comment markers
%%
%%   %[&AI: Claude]        <- marker lines written by the TeX Authorship VS Code extension
%%   text Claude wrote
%%   %[/&AI: Claude]
%%
%% Prefixes: @ human co-author, & AI, * reference. Unmarked text is yours and stays black.
%%
%% Usage:   \usepackage{authorship}              coloured draft under LuaLaTeX
%%          \usepackage[gradient]{authorship}    AI text in a moving gradient instead of one colour
%%          \usepackage[hide]{authorship}        switched off, plain output
%% Under pdfLaTeX the package does nothing: the markers stay ordinary comments.
%%
%% MIT licence, https://github.com/odv-hu/tex-authorship
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{authorship}[2026/10/24 v0.1.16 Colour text by author from comment markers]

\newif\ifauthorship@show     \authorship@showtrue
\newif\ifauthorship@gradient \authorship@gradientfalse
\newif\ifauthorship@citations \authorship@citationsfalse
\DeclareOption{citations}{\authorship@citationstrue}
\DeclareOption{show}{\authorship@showtrue}
\DeclareOption{hide}{\authorship@showfalse}
\DeclareOption{gradient}{\authorship@gradienttrue}
\DeclareOption{solid}{\authorship@gradientfalse}
\ProcessOptions\relax

% Harmless fallbacks, so documents and .aux files work in every mode.
\providecommand\AuthorshipSetSummary[1]{}
\providecommand\AuthorshipSummary{}
\providecommand\AuthorshipSummaryFullWidth[1][Authorship summary]{}
\providecommand\AuthorshipColor[2]{}
\providecommand\AuthorshipGradient[2]{}
\providecommand\AuthorshipCitationColor[1]{}
% Name for your own (unmarked) text in the summary: \AuthorshipOwner{Balázs Fürtön}
\newcommand\AuthorshipOwnerName{Mine}
\newcommand\AuthorshipOwner[1]{\gdef\AuthorshipOwnerName{#1}}

\ifdefined\directlua\else
  \PackageInfo{authorship}{Not running LuaLaTeX: author markers stay plain comments}
  \expandafter\endinput
\fi
\ifauthorship@show\else
  \PackageInfo{authorship}{Option 'hide': author markers stay plain comments}
  \expandafter\endinput
\fi

\newattribute\authorship@attr
% Load the Lua half from the same folder as this file when possible (so a package loaded
% as \usepackage{../latex/authorship} still finds it), otherwise wherever TeX finds it.
% (No Lua comments or tildes inside \directlua: the code becomes one line, and ~ is active.)
\directlua{
  local here = "\luaescapestring{\CurrentFilePath}"
  local path = here .. "/authorship.lua"
  if here == "" or not lfs.isfile(path) then path = kpse.find_file("authorship.lua", "lua") end
  if not path then
    tex.error("Package authorship Error: authorship.lua not found; put it next to authorship.sty")
  else
    authorship = dofile(path)
    authorship.init(\the\allocationnumber, \ifauthorship@gradient true\else false\fi)
  end
}


% Citation colour accepts the same hex/RGB syntax as author colours.
\renewcommand\AuthorshipCitationColor[1]{%
  \directlua{authorship.set_citation_color("\luaescapestring{\detokenize{#1}}")}}

% Optional citation emphasis; keep attribution/counting separate from visual priority.
\ifauthorship@citations
  \newattribute\authorship@citationattr
  \directlua{authorship.citation_attr = \the\allocationnumber}
  \def\authorship@citationstyle{\authorship@citationattr=1\relax\bfseries}
  \AddToHook{begindocument/end}{%
    \let\authorship@originalcitex\@citex
    \@ifpackageloaded{natbib}{%
      % Natbib opens its own group before dispatch and closes it in \@cite.
      \def\@citex[#1][#2]#3{%
        \authorship@citationstyle\authorship@originalcitex[#1][#2]{#3}}%
    }{%
      \@ifpackageloaded{biblatex}{%
        \PackageWarning{authorship}{Option citations does not support biblatex}%
      }{%
        \def\@citex[#1]#2{%
          \begingroup\authorship@citationstyle
          \authorship@originalcitex[#1]{#2}\endgroup}%
      }%
    }}
\fi

% The Lua side rewrites each marker line into one of these as TeX reads the file.
% They are expandable on purpose: inside tables TeX looks ahead for \hline and
% \multicolumn, and an unexpandable command there would start a new cell.
\def\AuthorshipOpen#1{\directlua{authorship.open("#1")}}
\def\AuthorshipClose#1{\directlua{authorship.close("#1")}}

% \AuthorshipColor{AI: Claude}{0.9 0.1 0.5}  or by kind: \AuthorshipColor{ai}{...}
% Colours are RGB triples between 0 and 1.
\renewcommand\AuthorshipColor[2]{%
  \directlua{authorship.set_color("\luaescapestring{\detokenize{#1}}", "\luaescapestring{#2}")}}

% \AuthorshipGradient{AI: ChatGPT}{#2ecc71, #00b3b3, #2f6fdd}: this author's text runs through
% the colours (two or more; hex or "r g b" numbers; separate with ; if the numbers use commas).
\renewcommand\AuthorshipGradient[2]{%
  \directlua{authorship.set_gradient("\luaescapestring{\detokenize{#1}}", "\luaescapestring{\detokenize{#2}}")}}

% Running heads and page numbers are built in the output routine: keep them black
% even when a page breaks in the middle of a marked passage.
\def\authorship@suspend{\authorship@attr=-"7FFFFFFF\relax}
\AtBeginDocument{\output\expandafter{\expandafter\authorship@suspend\the\output}}

% Character counts from the previous run, for \AuthorshipSummary.
\def\AuthorshipWriteAux#1{%
  \immediate\write\@auxout{\string\providecommand\string\AuthorshipSetSummary[1]{}%
    \string\AuthorshipSetSummary{#1}}}
\renewcommand\AuthorshipSetSummary[1]{%
  \directlua{authorship.previous = "\luaescapestring{\detokenize{#1}}"}}
\renewcommand\AuthorshipSummary{\directlua{authorship.typeset_summary()}}

% Full-width summary: keep heading and table together in document flow.
% Two-column output requires a fresh page for full width.
\renewcommand\AuthorshipSummaryFullWidth[1][Authorship summary]{%
  \par
  \if@twocolumn\onecolumn\fi
  \addvspace{\medskipamount}%
  \noindent\begin{minipage}{\textwidth}%
    \authorship@attr="7FFFFF00\relax
    \normalfont\normalsize
    \if\relax\detokenize{#1}\relax\else
      {\itshape #1\par}\medskip
    \fi
    \noindent\directlua{authorship.typeset_summary(true)}%
  \end{minipage}\par}

% Legend squares in the summary: a thin black frame around one or more colour bands.
\newdimen\AuthorshipSwatchSize \AuthorshipSwatchSize=0.72em
\newcommand\AuthorshipSwatchBox[1]{{%
  \fboxsep=0pt \fboxrule=0.4pt \fbox{\hbox{#1}}}}
\newcommand\AuthorshipBand[2]{%
  \pdfextension colorstack 0 push {#2 rg #2 RG}%
  \vrule width #1\AuthorshipSwatchSize height \AuthorshipSwatchSize depth 0pt
  \pdfextension colorstack 0 pop\relax}
\AddToHook{enddocument/afterlastpage}{\directlua{authorship.finish()}}

\endinput
